# 環境變數範本。複製此檔為 .env 後填入你自己的值。
# 注意：.env 含有機密，已列入 .gitignore，絕對不可提交到版本控制。

# ---------- Supabase（本機 Supabase CLI 或你自己的專案） ----------
# 前端公開用的網址與匿名金鑰（anon key，會被瀏覽器看到，因此權限必須靠 RLS 管控）
# 注意：這個網址是「瀏覽器」要連的，不是容器內部網址。host.docker.internal 只在容器內有效，瀏覽器連不到。
# 同一台機器使用：http://127.0.0.1:54421（對應 supabase/config.toml 的 [api] port；Windows 保留 54321，故不用）；從外網使用：需要為 Supabase API 另外設一個 Cloudflare Tunnel 網域
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# 後端 API 的公開網址，瀏覽器直接呼叫它（Plan A）。同機使用填 http://127.0.0.1:8000，外網使用填後端的 Tunnel 網域
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 後端用的資料庫連線字串（只在後端使用，絕不放進前端）
# 用 postgres 使用者直連本機 Supabase 資料庫
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# 後端驗證使用者 JWT 用的 JWKS 位址（Supabase Auth 公開的公鑰端點，不含機密；容器內可用內部網址）
SUPABASE_JWKS_URL=http://host.docker.internal:54421/auth/v1/.well-known/jwks.json
# JWT 發行者必須等於 token 內 iss 欄位的值（本機為 http://127.0.0.1:54421/auth/v1）；與 JWKS 位址可以不同。外網部署時改為對外網域
SUPABASE_JWT_ISSUER=http://127.0.0.1:54421/auth/v1

# ---------- Gemini（免費層，對話與 Embedding） ----------
# 你自己的 Gemini API 金鑰。只放在本機 .env，不要貼到任何對話或程式碼中。
GEMINI_API_KEY=replace-with-your-gemini-key
# 對話模型型號請以 Google AI Studio 的免費層清單為準，免費條件可能變動
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding 輸出維度。必須與資料表 vector(1536) 一致，不可隨意更改。
EMBEDDING_DIMENSIONS=1536

# ---------- Ollama（本機備援與 /tuning 對比） ----------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b

# ---------- 額度與限制（已於架構確認時定案） ----------
# 每位使用者每日 Token 上限（50 萬）
USER_DAILY_TOKEN_LIMIT=500000
# 全站每日 Token 上限（200 萬）
GLOBAL_DAILY_TOKEN_LIMIT=2000000
# 單檔上傳大小上限（10 MB，以位元組計）
MAX_UPLOAD_BYTES=10485760
# 每位使用者每日上傳檔案數（20 檔）
USER_DAILY_UPLOAD_LIMIT=20
# 每位使用者每分鐘 AI 請求上限（10 次）
USER_RPM_LIMIT=10
# 全站每分鐘 AI 請求上限（保護 Gemini 免費層 RPM）
GLOBAL_RPM_LIMIT=30

# ---------- Cloudflare Tunnel（對外公開用，來自 Zero Trust 後台） ----------
TUNNEL_TOKEN=replace-with-your-tunnel-token

# ---------- 允許的前端來源（CORS 白名單，逗號分隔） ----------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
